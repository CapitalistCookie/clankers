    if args.action == 'check':
        check_regressions(days_after=args.days)
    elif args.action == 'anomalies':
        detect_anomalies(lookback_days=args.lookback, compare_days=args.compare)

def cmd_ingest(args):
    from ingest import ingest_from_args, ingest_from_stdin, ingest_batch
    import sys

    if args.batch:
        data = sys.stdin.read()
        success, errors = ingest_batch(data)
        print(f"Ingested: {success} events, {errors} errors")
        return

    if not args.event:
        # Read from stdin (piped JSON)
        ok, sid, errs = ingest_from_stdin()
        if ok:
            print(sid)
        else:
            for e in errs:
                print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        return

    ok, sid, errs = ingest_from_args(
        event=args.event,
        agent=args.agent or "unknown",
        project=args.project or os.path.basename(os.getcwd()),
        cwd=args.cwd or os.getcwd(),
        session_id=args.session_id,
        duration=args.duration,
        outcome=args.outcome,
        summary=args.summary,
        files_changed=args.files_changed,
        exit_code=args.exit_code,
        git_diff_stats=args.git_diff_stats,
        agent_version=args.agent_version,
    )
    if ok:
        print(sid)
    else:
        for e in errs:
            print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_wrap(args):
    """Wrap any command with session tracking."""
    import subprocess, time, json, re

    project = args.project or os.path.basename(os.getcwd())
    agent = "generic"

    # Snapshot git state before
    git_before = {}
    try:
        git_before["branch"] = subprocess.check_output(
            ["git", "branch", "--show-current"], stderr=subprocess.DEVNULL, text=True
        ).strip()
        git_before["commit"] = subprocess.check_output(
            ["git", "log", "--oneline", "-1"], stderr=subprocess.DEVNULL, text=True
        ).strip()
    except:
        pass

    # Start session
    from ingest import ingest_from_args
    ok, sid, _ = ingest_from_args("session_start", agent, project, cwd=os.getcwd())
    if ok:
        print(f"[clanker] Session {sid[:8]} started", file=__import__('sys').stderr)

    # Run the command
    start = time.time()
    try:
        result = subprocess.run(args.command, shell=False)
        exit_code = result.returncode
    except KeyboardInterrupt:
        exit_code = 130
    except Exception as e:
        print(f"[clanker] Command failed: {e}", file=__import__('sys').stderr)
        exit_code = 1

    duration = int(time.time() - start)

    # Snapshot git state after
    git_diff = {}
    try:
        diff_stat = subprocess.check_output(
            ["git", "diff", "--shortstat", "HEAD"], stderr=subprocess.DEVNULL, text=True
        ).strip()
        if diff_stat:
            ins = re.search(r'(\d+) insertion', diff_stat)
            dels = re.search(r'(\d+) deletion', diff_stat)
            files = re.search(r'(\d+) file', diff_stat)
            git_diff = {
                "insertions": int(ins.group(1)) if ins else 0,
                "deletions": int(dels.group(1)) if dels else 0,
                "files": int(files.group(1)) if files else 0,
            }
    except:
        pass

    # Determine outcome
    outcome = "unknown"
    try:
        new_commit = subprocess.check_output(
            ["git", "log", "--oneline", "-1"], stderr=subprocess.DEVNULL, text=True
        ).strip()
        if git_before.get("commit") and new_commit != git_before["commit"]:
            outcome = "commit"
    except:
        pass
    if exit_code != 0:
        outcome = "abandoned"

    # End session
    ok, _, _ = ingest_from_args(
        "session_end", agent, project,
        cwd=os.getcwd(), session_id=sid,
        duration=duration, outcome=outcome,
        exit_code=exit_code, git_diff_stats=json.dumps(git_diff) if git_diff else None,
    )
    if ok:
        print(f"[clanker] Session {sid[:8]} ended ({duration}s, exit={exit_code})", file=__import__('sys').stderr)

# ─── Main ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(prog='clanker', description='Self-improving development harness')
    sub = parser.add_subparsers(dest='command')

    # === Tier 1 ===
    p = sub.add_parser('registry', help='Project registry')
    p.add_argument('action', choices=['list', 'archetype', 'hooks', 'path'])
    p.add_argument('name', nargs='?', default='')
    p.set_defaults(func=cmd_registry)

    p = sub.add_parser('sessions', help='Query session data')
    p.add_argument('--last', type=int, default=7, help='Days to look back')
    p.add_argument('--project', help='Filter by project')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_sessions)

    p = sub.add_parser('analyze', help='Run analysis')
    p.add_argument('mode', choices=['daily', 'weekly', 'errors', 'slow'], default='daily', nargs='?')
    p.add_argument('--by', choices=['project', 'tool', 'archetype'], default='project')
    p.add_argument('--last', type=int, default=7)
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_analyze)

    p = sub.add_parser('propose', help='Generate proposals (auto-expires pending >30d first)')
    p.add_argument('--from-retro', action='store_true')
    p.add_argument('--expire-before', default=None, metavar='YYYY-MM-DD',
                   help='ONLY expire pending proposals older than this date (no generation)')
    p.add_argument('--reason', default=None, help='reason recorded on expired proposals')
    p.set_defaults(func=cmd_propose)

    p = sub.add_parser('autonomy', help='Autonomy scoreboard — hands-off %% of sessions, intervention rate, where Claude needs you')
    p.add_argument('--last', type=int, default=30)
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_autonomy)

    p = sub.add_parser('ecc', help='Optional ECC-derived analyses (off by default; running one opts in)')
    p.add_argument('action', choices=['scan', 'parked', 'overlap', 'trend', 'risk', 'budget', 'guard'])
    p.add_argument('cmdline', nargs='*', help="Command to classify (guard); quote it, e.g. ecc guard 'git push --force'")
    p.add_argument('--last', type=int, default=30, help='Days of sessions to consider')
    p.add_argument('--pending', type=int, default=1800, help='Parked threshold (seconds with no tool result)')
    p.add_argument('--scan', dest='scan', type=int, default=20, help='Recent transcripts to risk-scan')
    p.add_argument('--limit', type=float, help='Budget limit in USD (for the budget action)')
    p.set_defaults(func=cmd_ecc)

    p = sub.add_parser('orch', help='Orchestration — spawn & steer agent sessions (OFF by default; WebUI-controllable)')
    p.add_argument('action', nargs='?', default='status',
                   choices=['status', 'on', 'off', 'set', 'spawn', 'list', 'stop', 'supervise', 'enqueue', 'dispatch'])
    p.add_argument('cmdline', nargs='*', help='action args: task / "key value" / session id')
    p.add_argument('--project', help='Project for spawn/enqueue')
    p.add_argument('--headless', action='store_true', help='Spawn a headless (claude --print) session')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_orch)

    p = sub.add_parser('review', help='Review pending proposals')
    p.set_defaults(func=cmd_review)

    p = sub.add_parser('alert', help='Alert management')
    p.add_argument('action', choices=['list', 'check', 'dismiss', 'create'])
    p.add_argument('--id', help='Alert ID')
    p.add_argument('--message', help='Alert message')
    p.add_argument('--cron', action='store_true')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_alert)

    p = sub.add_parser('version', help='Version and status')
    p.set_defaults(func=cmd_version)

    p = sub.add_parser('doctor', help='Self-diagnostics; with a project name, run the project CONTRACT check; --fleet = every registered project, one row each')
    p.add_argument('project', nargs='?', default=None,
                   help='project name: check registered/CLAUDE.md/state-file/ci/remote/no-plaintext-secrets')
    p.add_argument('--fleet', action='store_true',
                   help='contract check across the WHOLE registry (secret grep off; add --secrets)')
    p.add_argument('--secrets', action='store_true',
                   help='with --fleet: include the per-repo secret grep (slow on big repos)')
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser('sync', help='Repo ↔ installed-hook parity: --check (default) / --apply (install) / --pin (wire settings.json to dist copies)')
    p.add_argument('--check', action='store_true', help='parity table (default)')
    p.add_argument('--apply', action='store_true', help='install repo hooks into ~/.claude (git-snapshotted, selftested)')
    p.add_argument('--pin', action='store_true', help='rewrite settings.json repo paths -> clanker-dist (implies --apply)')
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser('publish', help='Sanitized sync to the public sister repo (strip + publint/gitleaks gates + commit)')
    p.add_argument('--check', action='store_true', help='dry-run: what would copy/delete')
    p.add_argument('--push', action='store_true', help='push the public repo after committing')
    p.set_defaults(func=cmd_publish)

    p = sub.add_parser('memory', help='Memory-file ops (lint-clean by construction): new / doctor')
    msub = p.add_subparsers(dest='memaction', required=True)
    mp = msub.add_parser('new', help='Scaffold a memory file + index pointer (frontmatter law enforced)')
    mp.add_argument('slug', help='kebab-case filename (no .md)')
    mp.add_argument('--type', required=True, choices=['user', 'feedback', 'project', 'reference'])
    mp.add_argument('--desc', required=True, help='one-line description (recall routes on this)')
    mp.add_argument('--project', default=None, help='target a project namespace instead of the global router')
    mp.add_argument('--body', default='', help='memory body text')
    mp.set_defaults(func=cmd_memory_new)
    mp = msub.add_parser('router-gen', help='Regenerate ROUTER-AUTO.md (registry snapshot) in the global memory dir')
    mp.set_defaults(func=cmd_memory_router_gen)
    mp = msub.add_parser('doctor', help='Lint-sweep a memory dir + regen INDEX_ALL.md')
    mp.add_argument('--project', default=None)
    mp.set_defaults(func=cmd_memory_doctor)

    p = sub.add_parser('create', help='Start a project from NOTHING: mkdir ~/projects/<name> + git init + scaffold contract + register + doctor. Then: clanker work <name>')
    p.add_argument('name', help='project name (becomes ~/projects/<name>) or explicit path')
    p.add_argument('--archetype', default=None, help='research | production | frontend | infra | tool (default: auto-detect)')
    p.set_defaults(func=cmd_create)

    p = sub.add_parser('adopt', help='Ingest an EXISTING repo: clone (URL) or use in place, register, scaffold missing contract pieces (CLAUDE.md/STATUS.md/ci), then doctor')
    p.add_argument('target', help='git URL, local path, or bare name (= ~/projects/<name>)')
    p.add_argument('--archetype', default=None, help='override archetype detection')
    p.add_argument('--new', action='store_true', help='(= clanker create) create the directory + git init before scaffolding')
    p.set_defaults(func=cmd_adopt)

    # === Tier 2 ===
    p = sub.add_parser('compile', help='Compile knowledge base from session data')
    p.add_argument('--dry-run', action='store_true')
    p.set_defaults(func=cmd_compile)

    p = sub.add_parser('lint-wiki', help='Check knowledge base consistency')
    p.set_defaults(func=cmd_lint_wiki)

    p = sub.add_parser('init', help='Onboard a new project')
    p.add_argument('name', help='Project name')
    p.add_argument('--archetype', help='Override archetype')
    p.add_argument('--detect', action='store_true', help='Only detect archetype, don\'t scaffold')
    p.add_argument('--no-tmux', action='store_true', help='Skip tmux session creation')
    p.set_defaults(func=cmd_init)

    p = sub.add_parser('remove', help='Remove project from clanker (keeps repo)')
    p.add_argument('name', help='Project name')
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser('tmux', help='Tmux session management')
    p.add_argument('action', choices=['list', 'add', 'remove'])
    p.add_argument('name', nargs='?', help='Session/project name')
    p.add_argument('--path', help='Project path (for add)')
    p.set_defaults(func=cmd_tmux)

    p = sub.add_parser('scratch', aliases=['new'],
                       help='Throwaway Claude session at the CURRENT dir — no project machinery. (Projects: `create`/`adopt`; project sessions: `work`.)')
    p.add_argument('name', nargs='*', help='Session name (default: auto-generated)')
    p.add_argument('--shell', action='store_true', help='Launch a bare shell instead of Claude')
    p.set_defaults(func=cmd_new)

    p = sub.add_parser('open', aliases=['attach'],
                       help='Attach to a session from `clanker new` (default: most recent)')
    p.add_argument('name', nargs='?', help='Session name (default: most recent)')
    p.set_defaults(func=cmd_open)

    p = sub.add_parser('work', help='Launch/attach a Claude work session IN a registered project repo (tmux + cd + claude)')
    p.add_argument('project', help='registry project name (clanker registry list)')
    p.add_argument('--shell', action='store_true', help='bare shell instead of claude')
    p.add_argument('--no-attach', action='store_true', help='start detached; do not attach')
    p.add_argument('--no-boot', action='store_true',
                   help='do not register this session in the boot map (~/.tmux-startup.sh); default is to register so it survives reboot')
    p.add_argument('--print-path', action='store_true', help='print resolved repo path and exit')
    p.add_argument('--resume', nargs='?', const=True, default=None, metavar='SESSION_ID',
                   help="resume a past conversation in this repo: bare --resume opens the picker (this repo's sessions only); with an id, resumes it directly")
    p.set_defaults(func=cmd_work)

    p = sub.add_parser('resurrect', help='Fleet recovery: relaunch missing boot-mapped tmux sessions (post-OOM/reboot; watchdog-callable)')
    p.add_argument('--dry-run', action='store_true', help='report what would change/launch; write and launch nothing')
    p.add_argument('--sync-registry', action='store_true',
                   help='also add registered projects missing from the boot map (default: recovery never grows the fleet)')
    p.set_defaults(func=cmd_resurrect)

    p = sub.add_parser('briefing', help='Generate project briefing')
    p.add_argument('project', help='Project name')
    p.set_defaults(func=cmd_briefing)

    # === Tier 3 ===
    p = sub.add_parser('audit', help='View audit trail')
    p.add_argument('--last', type=int, default=20)
    p.set_defaults(func=cmd_audit)

    # Scan a project for external-fact configs + verify drift-watchdog
    # coverage. Class-of-bug preventer from eigenstateresearch Session 7.
    p = sub.add_parser('audit-configs', help='Scan project for unchecked external-fact configs')
    p.add_argument('path', help='Project root path')
    p.set_defaults(func=cmd_audit_configs)

    p = sub.add_parser('gc', help='Garbage collection')
    p.add_argument('--dry-run', action='store_true')
    p.set_defaults(func=cmd_gc)

    p = sub.add_parser('resources', help='VM resource monitor')
    p.set_defaults(func=cmd_resources)

    p = sub.add_parser('temporal', help='Temporal analysis (time-of-day, day-of-week)')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_temporal)

    p = sub.add_parser('model-versions', help='Analyze by Claude Code version')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_model_versions)

    p = sub.add_parser('snapshot', help='Harness version snapshot')
    p.set_defaults(func=cmd_harness_snapshot)

    p = sub.add_parser('skills', help='Skill effectiveness analysis')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_skills)

    p = sub.add_parser('export', help='Export harness state')
    p.add_argument('--output', help='Output tarball path')
    p.set_defaults(func=cmd_export)

    p = sub.add_parser('import', help='Import harness state')
    p.add_argument('archive', help='Archive path')
    p.set_defaults(func=cmd_import)

    # === New Tier 3 ===
    p = sub.add_parser('cross-project', help='Cross-project pattern analysis')
    p.add_argument('--last', type=int, default=30)
    p.add_argument('--suggest', action='store_true', help='Suggest transfers')
    p.set_defaults(func=cmd_cross_project)

    p = sub.add_parser('contracts', help='Scan/check API contracts')
    p.add_argument('project', help='Project name')
    p.add_argument('--check', action='store_true', help='Check recent changes for contract violations')
    p.add_argument('--base', default='HEAD~1', help='Base ref for checking changes')
    p.set_defaults(func=cmd_contracts)

    p = sub.add_parser('context', help='Context window intelligence')
    p.add_argument('--project', help='Filter by project')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_context)

    p = sub.add_parser('plugins', help='List/run plugins')
    p.add_argument('action', choices=['list', 'run-analyzers', 'run-health'], nargs='?', default='list')
    p.set_defaults(func=cmd_plugins)

    p = sub.add_parser('dashboard', help='Generate HTML dashboard')
    p.add_argument('--output', help='Output file path')
    p.add_argument('--watch', action='store_true', help='Watch for data changes and auto-regenerate')
    p.set_defaults(func=cmd_dashboard)

    p = sub.add_parser('serve', help='Live dashboard server with terminal bridge')
    p.add_argument('--host', default='127.0.0.1', help='Bind address (default: 127.0.0.1 — loopback; the tunnel reaches it locally)')
    p.add_argument('--port', type=int, default=8899, help='Port (default: 8899)')
    p.add_argument('--ntfy-topic', help='ntfy.sh topic for input-needed notifications')
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser('serve-user', help='Manage dashboard logins (username + password + TOTP)')
    p.add_argument('action', choices=['add', 'list', 'remove', 'passwd', 'recovery'])
    p.add_argument('username', nargs='?', default='', help='Username (for add/remove/passwd/recovery)')
    p.add_argument('--force', action='store_true', help='Reset an existing user (add)')
    p.set_defaults(func=cmd_serve_user)

    p = sub.add_parser('suggest-skills', help='Search skills.sh for relevant skills')
    p.add_argument('--project', help='Project name')
    p.add_argument('--archetype', help='Override archetype')
    p.set_defaults(func=cmd_suggest_skills)

    # Drift watchdog scaffolder — addresses the eigenstateresearch
    # Session 7 class-of-bug where data-config silently drifted from
    # external truth without any plugin watching for it.
    p = sub.add_parser('new-watchdog', help='Scaffold a new drift-watchdog plugin')
    p.add_argument('name', help='Plugin slug, e.g. "station-drift"')
    p.add_argument('--kind', default='config-drift',
                   choices=['config-drift', 'api-contract', 'param-bounds'],
                   help='Watchdog flavor (default config-drift)')
    p.add_argument('--dir', default=None,
                   help='Output directory (defaults to plugin install dir)')
    p.set_defaults(func=cmd_new_watchdog)

    p = sub.add_parser('decompose', help='Analyze prompt complexity')
    p.add_argument('text', nargs='*', help='Task description')
    p.add_argument('--prompt', help='Task description (alternative)')
    p.add_argument('--project', help='Project context')
    p.set_defaults(func=cmd_decompose)

    p = sub.add_parser('regression', help='Regression detection')
    p.add_argument('action', choices=['check', 'anomalies'], default='check', nargs='?')
    p.add_argument('--days', type=int, default=14, help='Days after implementation to check')
    p.add_argument('--lookback', type=int, default=7, help='Recent window for anomaly detection')
    p.add_argument('--compare', type=int, default=30, help='Historical window for comparison')
    p.set_defaults(func=cmd_regression)

    # === Universal ===
    p = sub.add_parser('ingest', help='Ingest events from any source')
    p.add_argument('--event', choices=['session_start', 'session_end', 'heartbeat'])
    p.add_argument('--agent', help='Agent name (claude-code, cursor, generic, ci)')
    p.add_argument('--project', help='Project name')
    p.add_argument('--cwd', help='Working directory')
    p.add_argument('--session-id', help='Session ID (auto-generated if omitted)')
    p.add_argument('--duration', type=int, help='Duration in seconds')
    p.add_argument('--outcome', choices=['commit', 'push', 'deploy', 'abandoned', 'unknown'])
    p.add_argument('--summary', help='Session summary')
    p.add_argument('--files-changed', help='Comma-separated file list')
    p.add_argument('--exit-code', type=int, help='Exit code')
    p.add_argument('--git-diff-stats', help='JSON: {"insertions":N,"deletions":N,"files":N}')
    p.add_argument('--agent-version', help='Agent version string')
    p.add_argument('--batch', action='store_true', help='Read JSONL from stdin')
    p.set_defaults(func=cmd_ingest)

    p = sub.add_parser('wrap', help='Wrap any command with session tracking')
    p.add_argument('command', nargs='+', help='Command to wrap')
    p.add_argument('--project', help='Project name (default: current dir name)')
    p.set_defaults(func=cmd_wrap)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    sys.exit(args.func(args) or 0)

if __name__ == '__main__':
    main()
