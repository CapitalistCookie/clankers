    elif args.action == 'list':
        serve_user.list_all()

def cmd_decompose(args):
    from decompose import check_prompt
    prompt = args.prompt or " ".join(args.text) if args.text else None
    if not prompt:
        import sys
        if not sys.stdin.isatty():
            prompt = sys.stdin.read().strip()
    if not prompt:
        print("Usage: clanker decompose 'your task description'")
        print("   or: echo 'task' | clanker decompose")
        return
    check_prompt(prompt, project=args.project)

def cmd_regression(args):
    from regression import check_regressions, detect_anomalies
    if args.action == 'check':
        check_regressions(days_after=args.days)
    elif args.action == 'anomalies':
        detect_anomalies(lookback_days=args.lookback, compare_days=args.compare)

def cmd_ingest(args):
    from ingest import ingest_from_args, ingest_from_stdin, ingest_batch
    import sys

    if args.batch:
        data = sys.stdin.read()
        success, errors = ingest_batch(data)
        print(f"Ingested: {success} events, {errors} errors")
        return

    if not args.event:
        # Read from stdin (piped JSON)
        ok, sid, errs = ingest_from_stdin()
        if ok:
            print(sid)
        else:
            for e in errs:
                print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        return

    ok, sid, errs = ingest_from_args(
        event=args.event,
        agent=args.agent or "unknown",
        project=args.project or os.path.basename(os.getcwd()),
        cwd=args.cwd or os.getcwd(),
        session_id=args.session_id,
        duration=args.duration,
        outcome=args.outcome,
        summary=args.summary,
        files_changed=args.files_changed,
        exit_code=args.exit_code,
        git_diff_stats=args.git_diff_stats,
        agent_version=args.agent_version,
    )
    if ok:
        print(sid)
    else:
        for e in errs:
            print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_wrap(args):
    """Scripted `claude -p` pinned + isolated, or any command with session tracking."""
    from wrap import main_from_args
    return main_from_args(args)

