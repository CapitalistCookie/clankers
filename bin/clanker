def cmd_contracts(args):
    from contracts import scan_contracts, check_contract_changes
    from registry import Registry
    reg = Registry()
    path = reg.get_path(args.project)
    if not path or not os.path.isdir(path):
        print(f"contracts: unknown project or missing path: {args.project}", file=sys.stderr)
        return 1
    if args.check:
        check_contract_changes(args.project, base_ref=args.base)
    else:
        contracts = scan_contracts(path)
        total = sum(len(v) for v in contracts.values())
        print(f"=== Contracts in {args.project} ===\n")
        for ctype, items in contracts.items():
            if items:
                print(f"{ctype}: {len(items)}")
                for item in items[:10]:
                    if ctype == "http":
                        print(f"  {item['method']} {item['path']} ({item['file']})")
                    elif ctype == "websocket":
                        print(f"  event '{item['event']}' ({item['file']})")
                    elif ctype == "pubsub":
                        print(f"  channel '{item['channel']}' ({item['file']})")
                if len(items) > 10:
                    print(f"  ...and {len(items) - 10} more")
        print(f"\nTotal: {total} contracts")

