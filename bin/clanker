# The help page: what people run, grouped. Every verb is in one group or in
# HIDDEN (still callable; `clanker help all`) — tests/test_cli_ux.py checks it.
HELP_GROUPS = [
    ("Sessions", [
        ("ls [slot]", "every account's 5h/7d usage and every Claude session (also: bare `clanker`)"),
        ("open <project|session> [slot]", "go there: attach, or start Claude (on the account you name); a slot moves it"),
        ("new [slot] [project] [name]", "another Claude session in a project (default: the one you are in)"),
        ("close <session>", "end it: Claude exits cleanly, the session and its boot entry go"),
    ]),
    ("Projects", [("project [ls|create|adopt|remove|path]", "the projects and their Claude sessions; start, take in, drop"),
                  ("briefing <project>", "a project's briefing")]),
    ("Fleet health", [("doctor · alert · sync · gc · resources · schedules · audit · version · resurrect", "")]),
    ("Dashboard", [("serve · serve-user", "the web dashboard and its logins")]),
    ("Analysis", [("sessions · analyze · autonomy · skills · context · propose · review", "")]),
    ("Automation", [("orch · wrap · ingest · memory · publish · settings · plugins", "")]),
]
HIDDEN = {"init", "dashboard", "compile", "lint-wiki", "temporal", "model-versions", "decompose",
          "regression", "suggest-skills", "cross-project", "contracts", "export", "import", "snapshot",
          "new-watchdog", "audit-configs", "ecc", "completion", "_complete",
          "scratch", "attach", "list", "work", "tmux", "projects", "create", "adopt", "remove", "registry"}


def help_verbs():
    """The verbs the help page lists, in order."""
    out = []
    for _g, items in HELP_GROUPS:
        for cmd, _d in items:
            out += [x.strip().split()[0] for x in cmd.split("·")] if "·" in cmd else [cmd.split()[0]]
    return out


def grouped_help():
    lines = ["clanker — Claude Code sessions on your accounts, projects, fleet health, dashboard", ""]
    for g, items in HELP_GROUPS:
        lines.append(g)
        for cmd, desc in items:
            lines.append(f"  {cmd:30} {desc}".rstrip() if len(cmd) <= 30 else f"  {cmd}" + (f"\n  {'':30} {desc}" if desc else ""))
        lines.append("")
    lines += ["Examples",
              "  clanker open clanker a3        go to clanker's session; Claude starts on a3 if none runs",
              "  clanker new a3                 another session in the project you are in",
              "  clanker open -                 back to the session you came from",
              "  clanker close --idle 30d -n    the sessions idle 30 days (nothing changes)",
              "",
              "clanker help <command>   one command in detail      clanker help all   every command",
              "Flags: -q quiet · --json results · -y no questions · -n dry run · -V version",
              'Tab completion: add  eval "$(clanker completion)"  to ~/.bashrc (zsh: completion zsh; fish: completion fish)']
    return "\n".join(lines)


_BASH_COMPLETION = '''_clanker_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}" IFS=$'\\n'
  COMPREPLY=($(compgen -W "$(clanker _complete "${COMP_WORDS[@]:1:$((COMP_CWORD-1))}" 2>/dev/null)" -- "$cur"))
}
complete -o default -F _clanker_complete clanker'''


def cmd_completion(args):
    """bash and zsh (through bashcompinit) share one function; fish asks the same
    `clanker _complete` for the words after the command."""
    if args.shell == "fish":
        print("# clanker tab completion (fish): clanker completion fish | source\n"
              "complete -c clanker -f -a '(clanker _complete (commandline -opc)[2..-1] 2>/dev/null)'")
    elif args.shell == "zsh":
        print('# clanker tab completion (zsh): eval "$(clanker completion zsh)"\n'
              "autoload -U +X bashcompinit && bashcompinit\n" + _BASH_COMPLETION)
    else:
        print('# clanker tab completion (bash): eval "$(clanker completion)"\n' + _BASH_COMPLETION)
    return 0


def _slot_ids():
    """Usable slot IDs, fast: the statusline's cached slot map, else claude-acct."""
    try:
        with open(os.path.expanduser("~/.cache/clanker/accounts.json")) as f:
            rows = json.load(f)
        return [r["slot"] for r in rows if r.get("status") == "live"]
    except Exception:
        pass
    try:
        import accounts
        return [s["id"] for s in accounts.slots() if s["usable"] and not s.get("single")]
    except Exception:
        return []


def cmd_complete(args):
    """Candidates for the word after `clanker <words...>` (one per line)."""
    import accounts
    w = [x for x in (args.words or []) if x != "--"]
    if not w:
        print("\n".join(sorted(set(help_verbs()) | {"help"})))
        return 0
    verb, rest = w[0], w[1:]
    has_slot = any(accounts.SLOT_RX.match(x) for x in rest)
    slots = [] if has_slot else _slot_ids()
    out = []
    if verb in ("open", "attach", "work"):
        import fleet
        out = sorted(set(fleet.session_names()) | set(_project_names())) + slots
    elif verb in ("new", "scratch"):
        out = slots + ([] if [x for x in rest if not accounts.SLOT_RX.match(x)] else _project_names())
    elif verb == "close":
        import fleet
        out = fleet.session_names() if not rest else []
    elif verb in ("project", "projects"):
        out = ["ls", "create", "adopt", "remove", "path"] if not rest else \
            (_project_names() if rest[0] in ("remove", "path") and len(rest) == 1 else [])
    elif verb in ("ls", "list"):
        out = slots + ["-a", "--json", "-w"]
    elif verb == "tmux":
        out = ["list", "add", "remove", "accept-trust"] if not rest else (slots if rest[0] == "add" and len(rest) >= 2 else [])
    elif verb == "help":
        out = sorted(set(help_verbs())) + ["all"]
    print("\n".join(out))
    return 0


def _project_names():
    try:
        from registry import Registry
        return sorted(Registry().projects.keys())
    except Exception:
        return []


def _unknown_verb(word, verbs):
    """A friendly answer to `clanker <typo>`: `openclanker` → `clanker open clanker`."""
    import difflib
    tips = []
    for v in ("open", "new", "close", "ls"):
        if word.startswith(v) and len(word) > len(v):
            tips.append(f"clanker {v} {word[len(v):]}")
    tips += [f"clanker {m}" for m in difflib.get_close_matches(word, sorted(verbs), n=3, cutoff=0.6)]
    msg = f"clanker: unknown command '{word}'"
    if tips:
        msg += " — did you mean: " + ", ".join(dict.fromkeys(tips))
    print(msg + "\n(clanker help lists the commands)", file=sys.stderr)
    return 2


def build_parser():
    parser = argparse.ArgumentParser(prog='clanker', description='Claude Code fleet: sessions on accounts, projects, health, dashboard')
    sub = parser.add_subparsers(dest='command', metavar='<command>')

    # === Tier 1 ===
    p = sub.add_parser('registry', help='Project registry')
    p.add_argument('action', choices=['list', 'archetype', 'hooks', 'path'])
    p.add_argument('name', nargs='?', default='')
    p.set_defaults(func=cmd_registry)

    p = sub.add_parser('sessions', help='Query session data')
    p.add_argument('--last', type=int, default=7, help='Days to look back')
    p.add_argument('--project', help='Filter by project')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_sessions)

    p = sub.add_parser('analyze', help='Run analysis')
    p.add_argument('mode', choices=['daily', 'weekly', 'errors', 'slow'], default='daily', nargs='?')
    p.add_argument('--by', choices=['project', 'tool', 'archetype'], default='project')
    p.add_argument('--last', type=int, default=7)
    p.add_argument('--json', action='store_true')
    p.add_argument('--rewrites', action='store_true', help='Top sessions by cache-rewrite tokens over --last days (default 7)')
    p.set_defaults(func=cmd_analyze)

    p = sub.add_parser('propose', help='Generate proposals (auto-expires pending >30d first); --add files one by hand; --resolve closes one')
    p.add_argument('--from-retro', action='store_true')
    p.add_argument('--expire-before', default=None, metavar='YYYY-MM-DD',
                   help='ONLY expire pending proposals older than this date (no generation)')
    p.add_argument('--reason', default=None, help='reason recorded on expired proposals')
    p.add_argument('--add', action='store_true',
                   help='file a manual proposal (requires --project, --desc, --impact)')
    p.add_argument('--project', default=None, help='project the proposal belongs to')
    p.add_argument('--desc', default=None, help='what should change and why')
    p.add_argument('--impact', default=None, help='expected impact when implemented')
    p.add_argument('--type', default='manual', help='proposal type slug (default: manual)')
    p.add_argument('--resolve', default=None, metavar='ID_OR_SUBSTR',
                   help='mark a proposal implemented/rejected (exact id, or substring matching one open proposal)')
    p.add_argument('--status', default='implemented',
                   choices=['implemented', 'accepted', 'rejected'],
                   help='status --resolve records (default: implemented)')
    p.add_argument('--note', default='', help='note appended on --resolve')
    p.set_defaults(func=cmd_propose)

    p = sub.add_parser('autonomy', help='Autonomy scoreboard — hands-off %% of sessions, intervention rate, where Claude needs you')
    p.add_argument('--last', type=int, default=30)
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_autonomy)

    p = sub.add_parser('ecc', help='Optional ECC-derived analyses (off by default; running one opts in)')
    p.add_argument('action', choices=['scan', 'parked', 'overlap', 'trend', 'risk', 'budget', 'guard'])
    p.add_argument('cmdline', nargs='*', help="Command to classify (guard); quote it, e.g. ecc guard 'git push --force'")
    p.add_argument('--last', type=int, default=30, help='Days of sessions to consider')
    p.add_argument('--pending', type=int, default=1800, help='Parked threshold (seconds with no tool result)')
    p.add_argument('--scan', dest='scan', type=int, default=20, help='Recent transcripts to risk-scan')
    p.add_argument('--limit', type=float, help='Budget limit in USD (for the budget action)')
    p.set_defaults(func=cmd_ecc)

    p = sub.add_parser('orch', help='Orchestration — spawn & steer agent sessions (OFF by default; WebUI-controllable)')
    p.add_argument('action', nargs='?', default='status',
                   choices=['status', 'on', 'off', 'set', 'spawn', 'list', 'stop', 'supervise', 'enqueue', 'dispatch'])
    p.add_argument('cmdline', nargs='*', help='action args: task / "key value" / session id')
    p.add_argument('--project', help='Project for spawn/enqueue')
    p.add_argument('--headless', action='store_true', help='Spawn a headless (claude --print) session')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_orch)

    p = sub.add_parser('review', help='Review pending proposals')
    p.set_defaults(func=cmd_review)

    p = sub.add_parser('alert', help='Alert management')
    p.add_argument('action', choices=['list', 'check', 'dismiss', 'create'])
    p.add_argument('--id', help='Alert ID')
    p.add_argument('--message', help='Alert message')
    p.add_argument('--cron', action='store_true')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_alert)

    p = sub.add_parser('version', help='Version and status')
    p.set_defaults(func=cmd_version)

    p = sub.add_parser('doctor', help='Self-diagnostics; with a project name, run the project CONTRACT check; --fleet = every registered project, one row each; --harness = harness lint table')
    p.add_argument('project', nargs='?', default=None,
                   help='project name: check registered/CLAUDE.md/state-file/ci/remote/no-plaintext-secrets')
    p.add_argument('--fleet', action='store_true',
                   help='contract check across the WHOLE registry (secret grep off; add --secrets)')
    p.add_argument('--secrets', action='store_true',
                   help='with --fleet: include the per-repo secret grep (slow on big repos)')
    p.add_argument('--harness', action='store_true',
                   help='harness lint: project refs in global files, skill descriptions > 300 chars, CLAUDE.md > 6 KB, '
                        'STATUS.md NOW, hook timeouts > 60 s, missing hook scripts, rules scope, alerts dir, '
                        'global env keys, hook errors (24 h); exit 1 on any finding')
    p.add_argument('--json', action='store_true', help='with --harness: JSON instead of the table')
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser('sync', help='Repo ↔ installed-hook parity: --check (default) / --apply (install) / --pin (wire settings.json to dist copies)')
    p.add_argument('--check', action='store_true', help='parity table (default)')
    p.add_argument('--apply', action='store_true', help='install repo hooks into ~/.claude (git-snapshotted, selftested)')
    p.add_argument('--pin', action='store_true', help='rewrite settings.json repo paths -> clanker-dist (implies --apply)')
    p.add_argument('--force', action='store_true',
                   help='with --apply/--pin: overwrite installed files that were edited or removed outside clanker sync')
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser('publish', help='Sanitized sync to the public sister repo (strip + publint/gitleaks gates + commit)')
    p.add_argument('--check', action='store_true', help='dry-run: what would copy/delete')
    p.add_argument('--push', action='store_true', help='push the public repo after committing')
    p.set_defaults(func=cmd_publish)

    p = sub.add_parser('memory', help='Memory-file ops (lint-clean by construction): new / doctor')
    msub = p.add_subparsers(dest='memaction', required=True)
    mp = msub.add_parser('new', help='Scaffold a memory file + index pointer (frontmatter law enforced)')
    mp.add_argument('slug', help='kebab-case filename (no .md)')
    mp.add_argument('--type', required=True, choices=['user', 'feedback', 'project', 'reference'])
    mp.add_argument('--desc', required=True, help='one-line description (recall routes on this)')
    mp.add_argument('--project', default=None, help='target a project namespace instead of the global router')
    mp.add_argument('--body', default='', help='memory body text')
    mp.set_defaults(func=cmd_memory_new)
    mp = msub.add_parser('router-gen', help='Regenerate ROUTER-AUTO.md (registry snapshot) in the global memory dir')
    mp.set_defaults(func=cmd_memory_router_gen)
    mp = msub.add_parser('doctor', help='Lint-sweep a memory dir + regen INDEX_ALL.md')
    mp.add_argument('--project', default=None)
    mp.set_defaults(func=cmd_memory_doctor)

    p = sub.add_parser('create', help='Start a project from NOTHING: mkdir ~/projects/<name> + git init + scaffold contract + register + doctor. Then: clanker open <name> <slot>')
    p.add_argument('name', help='project name (becomes ~/projects/<name>) or explicit path')
    p.add_argument('--archetype', default=None, help='research | production | frontend | infra | tool (default: auto-detect)')
    p.set_defaults(func=cmd_create)

    p = sub.add_parser('adopt', help='Ingest an EXISTING repo: clone (URL) or use in place, register, scaffold missing contract pieces (CLAUDE.md/STATUS.md/ci), then doctor')
    p.add_argument('target', help='git URL, local path, or bare name (= ~/projects/<name>)')
    p.add_argument('--archetype', default=None, help='override archetype detection')
    p.add_argument('--new', action='store_true', help='(= clanker create) create the directory + git init before scaffolding')
    p.set_defaults(func=cmd_adopt)

    # === Tier 2 ===
    p = sub.add_parser('compile', help='Compile knowledge base from session data')
    p.add_argument('--dry-run', action='store_true')
    p.set_defaults(func=cmd_compile)

    p = sub.add_parser('lint-wiki', help='Check knowledge base consistency')
    p.set_defaults(func=cmd_lint_wiki)

    p = sub.add_parser('init', help='Onboard a new project')
    p.add_argument('name', help='Project name')
    p.add_argument('--archetype', help='Override archetype')
    p.add_argument('--detect', action='store_true', help='Only detect archetype, don\'t scaffold')
    p.add_argument('--no-tmux', action='store_true', help='Skip tmux session creation')
    p.set_defaults(func=cmd_init)

    p = sub.add_parser('remove', help='Remove project from clanker (keeps repo; asks first; its session closes)')
    p.add_argument('name', help='Project name')
    p.add_argument('-y', '--yes', action='store_true', help='do not ask (needed without a terminal)')
    p.add_argument('-f', '--force', action='store_true', help='close its session even when Claude is working')
    p.add_argument('--force-schedules', action='store_true',
                   help='Proceed even though the project still owns active cron/timers '
                        '(only after dispositioning each one)')
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser('schedules',
                       help='Inventory/plan decommission of cron + systemd work')
    p.add_argument('action', choices=['scan', 'audit', 'plan-disable'],
                   help="scan: list items; audit: find orphaned work whose project "
                        "is gone; plan-disable: emit disable commands for a project")
    p.add_argument('--project', help='Limit to one registered project')
    p.add_argument('--path', help='Limit to a repo PATH (use for orphans — a '
                                  'retired repo is no longer in the registry)')
    p.add_argument('--reason', default='dead-project',
                   help='Suffix reason used in .disabled-<reason>-<date>')
    p.set_defaults(func=cmd_schedules)

    p = sub.add_parser('tmux', help='Tmux session management')
    p.add_argument('action', choices=['list', 'add', 'remove', 'accept-trust'])
    p.add_argument('name', nargs='?', help='Session/project name')
    p.add_argument('--path', help='Project path (for add)')
    p.add_argument('extra', nargs='*', help='add: an account slot (a3) to start Claude on; without one the session is a plain shell')
    p.add_argument('--timeout', type=float, default=120.0,
                   help='accept-trust: seconds to keep watching the pane(s) (default 120)')
    p.set_defaults(func=cmd_tmux)

    raw = argparse.RawDescriptionHelpFormatter
    out_flags = lambda q: (q.add_argument('-q', '--quiet', action='store_true', help='no messages, only errors and the result'),
                           q.add_argument('--json', action='store_true', help='the result as JSON on stdout'))

    p = sub.add_parser('new', aliases=['scratch'], formatter_class=raw,
                       help='Another Claude session in a project: clanker new a3 [project] [name] (opens it)',
                       epilog='''examples:
  clanker new a3                     another session in the project you are in
  clanker new a3 clanker review      a session named "review" in the clanker project
  s=$(clanker new a3 clanker -d)     in a script: start it, get its name
  clanker new --shell                a plain shell here (no project, no account)

Every Claude session runs in a project. Outside one, a terminal offers the close
match, then to create the project; a script gets exit 1 and the command to run.''')
    p.add_argument('words', nargs='*', metavar='[slot] [project] [name]',
                   help='the account (a1, a3, …; asked for on a terminal), a project (default: the one '
                        'you are in) and a session name (default: the project\'s)')
    p.add_argument('--shell', action='store_true', help='a plain shell here instead of Claude (no project, no account)')
    p.add_argument('-d', '--detach', action='store_true', help='start it, do not open it')
    p.add_argument('--resume', nargs='?', const=True, default=None, metavar='SESSION_ID',
                   help='continue a past conversation: bare --resume opens the picker, an id resumes it')
    out_flags(p)
    p.set_defaults(func=cmd_new)

    p = sub.add_parser('open', aliases=['attach', 'work'], formatter_class=raw,
                       help='Go to a session or project: attach, start Claude in it, or start the project\'s session; a slot moves it',
                       epilog='''examples:
  clanker open clanker               go to clanker's session (Claude starts there if it is a shell)
  clanker open clanker a3            the same, on account a3; a running Claude moves to a3
  clanker open -                     back to the session you came from
  clanker open                       pick from a list (on a terminal)

On a terminal, names are forgiven (case, spaces, prefixes, typos). A script names
the session or project exactly (case aside).''')
    p.add_argument('words', nargs='*', metavar='[project|session|-] [slot]',
                   help='a session or project name, or - for the previous session, and an account')
    p.add_argument('--shell', action='store_true', help='only the shell: do not start Claude')
    p.add_argument('-f', '--force', action='store_true',
                   help='with a slot: switch even when the prompt box holds unsent text (it is cleared)')
    p.add_argument('-d', '--detach', '--no-attach', dest='detach', action='store_true',
                   help='start it, do not open it')
    p.add_argument('--resume', nargs='?', const=True, default=None, metavar='SESSION_ID',
                   help='when Claude starts: bare --resume opens the picker (this project\'s conversations), an id resumes it')
    p.add_argument('--no-boot', action='store_true', help=argparse.SUPPRESS)
    p.add_argument('--print-path', action='store_true', help='print the project\'s repo path and exit')
    out_flags(p)
    p.set_defaults(func=cmd_open)

    p = sub.add_parser('close', formatter_class=raw,
                       help='End a session: Claude exits cleanly, the session and its boot entry go',
                       epilog='''examples:
  clanker close clanker-2            asks first; the conversation stays on disk
  clanker close clanker-2 -y         no question (a script needs -y)
  clanker close --idle 30d -n        list every session idle 30 days; change nothing
  clanker close --idle 30d --shells  close the plain shells idle 30 days (asked once)

Refused unless --force: a Claude that is working, unsent text in its prompt box,
other programs in the session.''')
    p.add_argument('words', nargs='*', metavar='session', help='the session (names forgiven on a terminal)')
    p.add_argument('-y', '--yes', action='store_true', help='do not ask (needed without a terminal)')
    p.add_argument('-f', '--force', action='store_true',
                   help='close even when Claude is working, text is unsent or other programs run')
    p.add_argument('--idle', metavar='DURATION', help='every session idle this long (30d, 12h, 90m), asked once')
    p.add_argument('--shells', action='store_true', help='with --idle: plain shells only')
    p.add_argument('-n', '--dry-run', action='store_true', help='show what would close; change nothing')
    out_flags(p)
    p.set_defaults(func=cmd_close)

    p = sub.add_parser('ls', aliases=['list'], formatter_class=raw,
                       help='Every account\'s 5h/7d usage and every Claude session, most urgent first',
                       epilog='''examples:
  clanker                            the same as clanker ls
  clanker ls a3                      one account and its sessions
  clanker ls -a                      also the plain shells
  clanker ls -w                      redraw every 2 s until Ctrl-C
  clanker ls --json | jq '.sessions[] | select(.state == "decision") | .name'

Colour on a terminal only; NO_COLOR=1 turns it off.''')
    p.add_argument('words', nargs='*', metavar='[slot]', help='only this account (a3)')
    p.add_argument('-a', '--all', action='store_true', help='also list plain shell sessions')
    p.add_argument('--json', action='store_true', help='machine-readable')
    p.add_argument('-w', '--watch', nargs='?', type=float, const=2.0, default=None, metavar='SECONDS',
                   help='redraw every SECONDS (default 2) until Ctrl-C')
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser('project', aliases=['projects'], formatter_class=raw,
                       help='Projects: ls (with their Claude sessions) · create · adopt · remove · path',
                       epilog='''examples:
  clanker project                    every project and how many Claude sessions run in it
  clanker project create notes       ~/projects/notes: git, CLAUDE.md, registry
  clanker project adopt ~/code/x     an existing repo becomes a project
  clanker project remove notes       asks first; the repo stays''')
    p.add_argument('action', nargs='?', default='ls', choices=['ls', 'list', 'create', 'adopt', 'remove', 'path'])
    p.add_argument('target', nargs='?', metavar='name|path|url')
    p.add_argument('--archetype', default=None, help='create/adopt: research | production | frontend | infra | tool')
    p.add_argument('-y', '--yes', action='store_true', help='remove: do not ask (needed without a terminal)')
    p.add_argument('-f', '--force', action='store_true', help='remove: close its session even when Claude is working')
    p.add_argument('--force-schedules', action='store_true', help='remove: past the scheduled-work gate (see clanker remove -h)')
    p.add_argument('--json', action='store_true', help='ls: machine-readable')
    p.set_defaults(func=cmd_project)

    p = sub.add_parser('completion', help='Print shell tab-completion: eval "$(clanker completion)" in ~/.bashrc (zsh: eval; fish: | source)')
    p.add_argument('shell', nargs='?', default='bash', choices=['bash', 'zsh', 'fish'])
    p.set_defaults(func=cmd_completion)

    p = sub.add_parser('_complete')
    p.add_argument('words', nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_complete)

    p = sub.add_parser('resurrect', help='Fleet recovery: recreate missing boot-mapped tmux sessions as plain shells (post-OOM/reboot; watchdog-callable; claude starts on demand via work)')
    p.add_argument('--dry-run', action='store_true', help='report what would change/create; write and create nothing')
    p.add_argument('--sync-registry', action='store_true',
                   help='also add registered projects missing from the boot map (default: recovery never grows the fleet)')
    p.set_defaults(func=cmd_resurrect)

    p = sub.add_parser('briefing', help='Generate project briefing')
    p.add_argument('project', help='Project name')
    p.set_defaults(func=cmd_briefing)

    # === Tier 3 ===
    p = sub.add_parser('audit', help='View audit trail')
    p.add_argument('--last', type=int, default=20)
    p.set_defaults(func=cmd_audit)

    # Scan a project for external-fact configs + verify drift-watchdog
    # coverage. Class-of-bug preventer from eigenstateresearch Session 7.
    p = sub.add_parser('audit-configs', help='Scan project for unchecked external-fact configs')
    p.add_argument('path', help='Project root path')
    p.set_defaults(func=cmd_audit_configs)

    p = sub.add_parser('gc', help='Garbage collection')
    p.add_argument('--dry-run', action='store_true')
    p.set_defaults(func=cmd_gc)

    p = sub.add_parser('resources', help='VM resource monitor')
    p.set_defaults(func=cmd_resources)

    p = sub.add_parser('temporal', help='Temporal analysis (time-of-day, day-of-week)')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_temporal)

    p = sub.add_parser('model-versions', help='Analyze by Claude Code version')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_model_versions)

    p = sub.add_parser('snapshot', help='Harness version snapshot')
    p.set_defaults(func=cmd_harness_snapshot)

    p = sub.add_parser('skills', help='Skill usage (default); `skills audit`: listing cost vs use per repo; `skills hide`: skillOverrides in a repo')
    p.add_argument('--last', type=int, default=30, help='usage report: days to look back')
    p.set_defaults(func=cmd_skills)
    ssub = p.add_subparsers(dest='skills_action')
    sp = ssub.add_parser('audit', help='per repo: skill, description bytes, uses (tracker + Claude Code), last use, verdict never/stale/active',
                         description='Join the skill inventory (~/.claude/skills and every repo .claude/skills) to '
                                     '$CLANKER_DATA/raw/skills and ~/.claude.json skillUsage. Verdict: never (no use), '
                                     'stale (last use > --stale-days), active.')
    sp.add_argument('repos', nargs='*', help='limit to these registry projects (and `user` for ~/.claude/skills)')
    sp.add_argument('--stale-days', type=int, default=90, help='days without use before a skill is stale (default 90)')
    sp.add_argument('--verdict', choices=['never', 'stale', 'active'], help='show only this verdict')
    sp.add_argument('--json', action='store_true')
    sp.set_defaults(func=cmd_skills_audit)
    sp = ssub.add_parser('hide', help='write skillOverrides {"<skill>": "off"} into <repo>/.claude/settings.local.json (merge; create)',
                         description='Hide skills from the listing in one repo. Modes (Claude Code 2.1.280): off = hidden from '
                                     'model and /name; user-invocable-only = hidden from the model, /name works; name-only = '
                                     'listed without description; on = default. Warns when settings.local.json is not gitignored.')
    sp.add_argument('repo', help='registry project name or repo directory')
    sp.add_argument('skills', nargs='+', help='skill name(s)')
    sp.add_argument('--mode', choices=['off', 'user-invocable-only', 'name-only', 'on'], default='off')
    sp.add_argument('--dry-run', action='store_true', help='print the merged file; write nothing')
    sp.set_defaults(func=cmd_skills_hide)

    p = sub.add_parser('settings', help='Archetype settings templates: `settings check <repo...>|--all` (drift), `settings apply <repo...> --key K` (write one key)')
    ssub = p.add_subparsers(dest='settings_action', required=True)
    sp = ssub.add_parser('check', help='per repo: template keys missing or different, extra keys, hook timeouts > 60 s; exit 1 on drift',
                         description='Compare each repo\'s tracked .claude/settings.json with templates/settings/<archetype>.json '
                                     '(registry `settings_templates: {overrides: {repo: template}}` picks another template).')
    sp.add_argument('repos', nargs='*', help='registry project names')
    sp.add_argument('--all', action='store_true', help='every registered repo')
    sp.add_argument('--json', action='store_true')
    sp.set_defaults(func=cmd_settings_check)
    sp = ssub.add_parser('apply', help='write the template value of one key into the named repos (minimal diff; --commit = one plain commit per repo)',
                         description='Never all repos at once: name them. A repo whose template lacks the key is refused. '
                                     '--commit refuses a dirty settings file and restores the file when the commit fails.')
    sp.add_argument('repos', nargs='+', help='registry project names')
    sp.add_argument('--key', required=True, help='template key, e.g. disableClaudeAiConnectors')
    sp.add_argument('--commit', action='store_true', help='commit .claude/settings.json alone, one commit per repo')
    sp.add_argument('--dry-run', action='store_true')
    sp.add_argument('--create', action='store_true', help='create .claude/settings.json when it is absent')
    sp.set_defaults(func=cmd_settings_apply)

    p = sub.add_parser('export', help='Export harness state')
    p.add_argument('--output', help='Output tarball path')
    p.set_defaults(func=cmd_export)

    p = sub.add_parser('import', help='Import harness state')
    p.add_argument('archive', help='Archive path')
    p.set_defaults(func=cmd_import)

    # === New Tier 3 ===
    p = sub.add_parser('cross-project', help='Cross-project pattern analysis')
    p.add_argument('--last', type=int, default=30)
    p.add_argument('--suggest', action='store_true', help='Suggest transfers')
    p.set_defaults(func=cmd_cross_project)

    p = sub.add_parser('contracts', help='Scan/check API contracts')
    p.add_argument('project', help='Project name')
    p.add_argument('--check', action='store_true', help='Check recent changes for contract violations')
    p.add_argument('--base', default='HEAD~1', help='Base ref for checking changes')
    p.set_defaults(func=cmd_contracts)

    p = sub.add_parser('context', help='Context window intelligence')
    p.add_argument('--project', help='Filter by project')
    p.add_argument('--last', type=int, default=30)
    p.set_defaults(func=cmd_context)

    p = sub.add_parser('plugins', help='List/run plugins')
    p.add_argument('action', choices=['list', 'run-analyzers', 'run-health'], nargs='?', default='list')
    p.set_defaults(func=cmd_plugins)

    p = sub.add_parser('dashboard', help='Generate HTML dashboard')
    p.add_argument('--output', help='Output file path')
    p.add_argument('--watch', action='store_true', help='Watch for data changes and auto-regenerate')
    p.set_defaults(func=cmd_dashboard)

    p = sub.add_parser('serve', help='Live dashboard server with terminal bridge')
    p.add_argument('--host', default='127.0.0.1', help='Bind address (default: 127.0.0.1 — loopback; the tunnel reaches it locally)')
    p.add_argument('--port', type=int, default=8899, help='Port (default: 8899)')
    p.add_argument('--ntfy-topic', help='ntfy.sh topic for input-needed notifications')
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser('serve-user', help='Manage dashboard logins (username + password + TOTP)')
    p.add_argument('action', choices=['add', 'list', 'remove', 'passwd', 'recovery'])
    p.add_argument('username', nargs='?', default='', help='Username (for add/remove/passwd/recovery)')
    p.add_argument('--force', action='store_true', help='Reset an existing user (add)')
    p.set_defaults(func=cmd_serve_user)

    p = sub.add_parser('suggest-skills', help='Search skills.sh for relevant skills')
    p.add_argument('--project', help='Project name')
    p.add_argument('--archetype', help='Override archetype')
    p.set_defaults(func=cmd_suggest_skills)

    # Drift watchdog scaffolder — addresses the eigenstateresearch
    # Session 7 class-of-bug where data-config silently drifted from
    # external truth without any plugin watching for it.
    p = sub.add_parser('new-watchdog', help='Scaffold a new drift-watchdog plugin')
    p.add_argument('name', help='Plugin slug, e.g. "station-drift"')
    p.add_argument('--kind', default='config-drift',
                   choices=['config-drift', 'api-contract', 'param-bounds'],
                   help='Watchdog flavor (default config-drift)')
    p.add_argument('--dir', default=None,
                   help='Output directory (defaults to plugin install dir)')
    p.set_defaults(func=cmd_new_watchdog)

    p = sub.add_parser('decompose', help='Analyze prompt complexity')
    p.add_argument('text', nargs='*', help='Task description')
    p.add_argument('--prompt', help='Task description (alternative)')
    p.add_argument('--project', help='Project context')
    p.set_defaults(func=cmd_decompose)

    p = sub.add_parser('regression', help='Regression detection')
    p.add_argument('action', choices=['check', 'anomalies'], default='check', nargs='?')
    p.add_argument('--days', type=int, default=14, help='Days after implementation to check')
    p.add_argument('--lookback', type=int, default=7, help='Recent window for anomaly detection')
    p.add_argument('--compare', type=int, default=30, help='Historical window for comparison')
    p.set_defaults(func=cmd_regression)

    # === Universal ===
    p = sub.add_parser('ingest', help='Ingest events from any source')
    p.add_argument('--event', choices=['session_start', 'session_end', 'heartbeat'])
    p.add_argument('--agent', help='Agent name (claude-code, cursor, generic, ci)')
    p.add_argument('--project', help='Project name')
    p.add_argument('--cwd', help='Working directory')
    p.add_argument('--session-id', help='Session ID (auto-generated if omitted)')
    p.add_argument('--duration', type=int, help='Duration in seconds')
    p.add_argument('--outcome', choices=['commit', 'push', 'deploy', 'abandoned', 'unknown'])
    p.add_argument('--summary', help='Session summary')
    p.add_argument('--files-changed', help='Comma-separated file list')
    p.add_argument('--exit-code', type=int, help='Exit code')
    p.add_argument('--git-diff-stats', help='JSON: {"insertions":N,"deletions":N,"files":N}')
    p.add_argument('--agent-version', help='Agent version string')
    p.add_argument('--batch', action='store_true', help='Read JSONL from stdin')
    p.set_defaults(func=cmd_ingest)

    p = sub.add_parser(
        'wrap',
        help='Run a scripted `claude -p` pinned and isolated (no user layer, MCP, skills or transcript; '
             'pinned model/effort, cost cap, timeout, one telemetry row); any other command runs with session tracking',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            'Run one scripted claude call the way a cron job or batch backend should:\n'
            '  claude -p --setting-sources project,local --strict-mcp-config --disable-slash-commands\n'
            '         --no-session-persistence --model M --effort E --max-budget-usd USD ...\n'
            'in $CLANKER_DATA/run/<caller>, with the parent session\'s CLAUDE_CODE_* env removed,\n'
            'CLANKER_WRAP=1 and CLANKER_WRAP_CALLER set, and one kind:nested row (Claude Code\'s own\n'
            'total_cost_usd) appended to raw/sessions. Stdout follows --output-format (text prints\n'
            '.result). Exit: claude\'s code; 124 timeout; 2 usage error; 127 claude missing.\n'
            'A command that is not claude runs under session tracking and returns its own exit code.'),
        epilog=(
            'examples:\n'
            '  clanker wrap --caller nightly --model claude-haiku-4-5-20251001 --effort low -- -p "Reply with exactly: OK"\n'
            '  clanker wrap --caller batch --model claude-sonnet-5 --effort medium --timeout 900 \\\n'
            '      -- claude -p --output-format json --tools "" < prompt.txt\n'
            '  clanker wrap make test          # generic: session tracking only\n'
            'note: put the prompt right after -p, or on stdin. claude list options (--allowedTools,\n'
            '--tools, --add-dir) take every word after them, a prompt included.'))
    p.add_argument('--caller', help='caller name: telemetry tag, CLANKER_WRAP_CALLER, and the run dir $CLANKER_DATA/run/<caller> (default: current dir name)')
    p.add_argument('--model', help='model to pin (required for claude, here or as claude --model)')
    p.add_argument('--effort', choices=['low', 'medium', 'high', 'xhigh', 'max'],
                   help='effort to pin (required for claude, here or as claude --effort)')
    p.add_argument('--max-cost', type=float, metavar='USD',
                   help='claude --max-budget-usd (default 5, or CLANKER_WRAP_MAX_COST; 0 = no cap); a run over it also warns')
    p.add_argument('--max-turns', type=int, metavar='N', help='claude --max-turns (agentic turn cap)')
    p.add_argument('--cwd', metavar='DIR', help='directory claude runs in (default: $CLANKER_DATA/run/<caller>)')
    p.add_argument('--timeout', type=float, metavar='S', help='kill claude\'s process group after S seconds; exit 124')
    p.add_argument('--allow-user-layer', action='store_true',
                   help='keep the user layer (global CLAUDE.md, user skills and hooks): omit --setting-sources')
    p.add_argument('--dry-run', action='store_true', help='print the resolved argv, cwd and env changes; run nothing')
    p.add_argument('--quiet', action='store_true', help='no summary line on stderr')
    p.add_argument('--project', help='project for the telemetry row (default: the project that owns the current dir)')
    p.add_argument('command', nargs=argparse.REMAINDER,
                   help='after --: `claude [args]`, bare claude args (-p ...), or any other command')
    p.set_defaults(func=cmd_wrap)

    return parser, sub


def main():
    global QUIET
    parser, sub = build_parser()
    argv = sys.argv[1:]
    while argv and argv[0] in ('-q', '--quiet'):
        QUIET, argv = True, argv[1:]
    if argv and argv[0] in ('-V', '--version'):
        v = _version()
        print(f"clanker {v}" if v else "clanker (version unknown)")
        sys.exit(0)
    if not argv:
        argv = ['ls']                     # bare `clanker`: the fleet at a glance
    elif argv[0] in ('-h', '--help', 'help'):
        if len(argv) > 1 and argv[1] == 'all':
            parser.print_help()
            sys.exit(0)
        if len(argv) > 1:
            argv = [argv[1], '-h']
        else:
            print(grouped_help())
            sys.exit(0)
    elif not argv[0].startswith('-') and argv[0] not in sub.choices:
        sys.exit(_unknown_verb(argv[0], [v for v in sub.choices if v not in HIDDEN]))
    args = parser.parse_args(argv)
    QUIET = QUIET or bool(getattr(args, 'quiet', False))
    if not args.command:
        print(grouped_help())
        sys.exit(1)

    sys.exit(args.func(args) or 0)

if __name__ == '__main__':
    main()
