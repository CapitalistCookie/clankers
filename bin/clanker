    from orch import cli as orch_cli
    sys.exit(orch_cli.run(args))

def cmd_propose(args):
    from propose import generate_proposals, expire_stale, add_proposal, resolve_proposal
    if args.add:
        if not (args.project and args.desc and args.impact):
            print("propose --add requires --project, --desc and --impact", file=sys.stderr)
            return 1
        return 0 if add_proposal(args.project, args.desc, args.impact,
                                 ptype=args.type) else 1
    if args.resolve:
        return resolve_proposal(args.resolve, status=args.status, note=args.note)
    if getattr(args, 'expire_before', None):
        expire_stale(before=args.expire_before, reason=args.reason)
        return
    generate_proposals(from_retro=args.from_retro)

def cmd_review(args):
    from propose import review_proposals
    review_proposals()

def cmd_alert(args):
    from alerts import handle_alert
    handle_alert(args.action, alert_id=args.id, message=args.message, cron=args.cron, json_output=args.json)

def _version():
    """plugin.json is the single version source; None for a detached install."""
    plugin_json = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', '.claude-plugin', 'plugin.json')
    try:
        with open(plugin_json) as f:
            return json.load(f)['version']
    except (OSError, ValueError, KeyError):
        return None


def cmd_version(args):
    v = _version()
    print(f"clanker v{v}" if v else "clanker (version unknown — plugin.json missing)")

    from analyze import load_sessions
    from alerts import count_alerts
    from propose import count_pending
    from wiki import get_wiki_stats

    sessions = load_sessions(last_days=7)
    alert_count = count_alerts()
    pending = count_pending()
    wiki_stats = get_wiki_stats()

    print(f"Sessions (7d): {len(sessions)}")
    print(f"Active alerts: {alert_count}")
    print(f"Pending proposals: {pending}")
    print(f"Wiki: {wiki_stats['total_articles']} articles, {wiki_stats['total_words']} words")

