#!/usr/bin/env python3
"""Clanker — Self-improving development harness CLI.

All phases: registry, sessions, analysis, proposals, alerts, knowledge base,
onboarding, audit, GC, resource monitoring, temporal analysis, export/import.
"""

import argparse
import sys
import os

# Add lib to path — resolve symlinks so this works from ~/bin/clanker
_this = os.path.realpath(__file__)
sys.path.insert(0, os.path.join(os.path.dirname(_this), '..', 'lib'))

# ─── Tier 1 Commands ─────────────────────────────────────────────────────────

def cmd_registry(args):
    from registry import Registry
    reg = Registry()
    if args.action == 'list':
        reg.list_projects()
    elif args.action == 'archetype':
        print(reg.get_archetype(args.name))
    elif args.action == 'hooks':
        for h in reg.get_hooks(args.name):
            print(h)
    elif args.action == 'path':
        print(reg.get_path(args.name))

def cmd_sessions(args):
    from analyze import load_sessions
    import json as _json
    sessions = load_sessions(last_days=args.last)
    if args.project:
        sessions = [s for s in sessions if s.get('project') == args.project]
    if not sys.stdin.isatty():
        # Reading from pipe — pass through
        for line in sys.stdin:
            sessions.append(_json.loads(line.strip()))
    if args.json:
        for s in sessions:
            print(_json.dumps(s))
    else:
        print(f"{'Date':<12} {'Project':<18} {'Duration':>8} {'Errors':>6} {'Tools':>6}")
        print('-' * 56)
        for s in sessions:
            dur = ("live" if s.get('outcome') == "open"
                   else f"{min(s.get('duration_s', 0), 28800) // 60}m")
            errs = s.get('errors', 0)
            tools = sum(s.get('tool_uses', {}).values())
            ts = s.get('timestamp', '')[:10]
            proj = s.get('project', '?')
            print(f"{ts:<12} {proj:<18} {dur:>8} {errs:>6} {tools:>6}")

