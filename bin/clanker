def cmd_version(args):
    import json as _json
    plugin_json = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', '.claude-plugin', 'plugin.json')
    try:
        with open(plugin_json) as f:
            meta = _json.load(f)
        print(f"clanker v{meta['version']}")
    except:
        print("clanker v0.2.0")

    from analyze import load_sessions
    from alerts import count_alerts
    from propose import count_pending
    from wiki import get_wiki_stats

    sessions = load_sessions(last_days=7)
    alert_count = count_alerts()
    pending = count_pending()
    wiki_stats = get_wiki_stats()

    print(f"Sessions (7d): {len(sessions)}")
    print(f"Active alerts: {alert_count}")
    print(f"Pending proposals: {pending}")
    print(f"Wiki: {wiki_stats['total_articles']} articles, {wiki_stats['total_words']} words")

