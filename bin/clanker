def cmd_skills_audit(args):
    """Skill listing cost (description bytes) against use, per repo; verdict never/stale/active."""
    import json as _json
    import harness_lint
    from skills_audit import audit, render, default_claude_json
    projects = harness_lint.load_projects(harness_lint.default_registry_path())
    if args.repos:
        unknown = [r for r in args.repos if r not in projects and r != 'user']
        if unknown:
            print(f"skills audit: unknown repo(s): {', '.join(unknown)} (clanker registry list)", file=sys.stderr)
            return 1
        projects = {n: p for n, p in projects.items() if n in args.repos}
    rows = audit(harness_lint.default_claude_dir(), projects, harness_lint.default_data_dir(),
                 default_claude_json(), stale_days=args.stale_days)
    if args.repos and 'user' not in args.repos:
        rows = [r for r in rows if r['repo'] != '(user)']
    if args.verdict:
        rows = [r for r in rows if r['verdict'] == args.verdict]
    print(_json.dumps(rows, indent=1) if args.json else render(rows, args.stale_days))
    return 0

def cmd_skills_hide(args):
    """Write skillOverrides into <repo>/.claude/settings.local.json."""
    import harness_lint
    from skills_audit import hide
    projects = harness_lint.load_projects(harness_lint.default_registry_path())
    path = projects.get(args.repo) or (os.path.abspath(os.path.expanduser(args.repo))
                                       if os.path.isdir(os.path.expanduser(args.repo)) else None)
    if not path:
        print(f"skills hide: unknown repo {args.repo!r} (a registry name or a directory)", file=sys.stderr)
        return 1
    return hide(path, args.skills, mode=args.mode, dry_run=args.dry_run)

def cmd_settings_check(args):
    """Per-repo drift from the archetype settings template; exit 1 on drift."""
    import json as _json
    from settings_templates import check, render
    if not args.repos and not args.all:
        print("settings check: name repo(s) or pass --all", file=sys.stderr)
        return 2
    rows = check(None if args.all else args.repos)
    print(_json.dumps(rows, indent=1) if args.json else render(rows))
    return 1 if any(r['status'] != 'ok' for r in rows) else 0

def cmd_settings_apply(args):
    """Write one template key into the named repos' .claude/settings.json."""
    import harness_lint
    from registry import Registry
    from settings_templates import apply_key, load_config
    reg_path = harness_lint.default_registry_path()
    projects = harness_lint.load_projects(reg_path)
    reg, cfg = Registry(reg_path), load_config(reg_path)
    rc = 0
    for name in args.repos:
        if name not in projects:
            print(f"{name}: not a registered repo on disk", file=sys.stderr)
            rc = 1
            continue
        rc |= apply_key(name, projects[name], reg.get_archetype(name), args.key, cfg,
                        commit=args.commit, dry_run=args.dry_run, create=args.create)
    return rc

