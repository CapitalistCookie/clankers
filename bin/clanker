def cmd_doctor(args):
    if getattr(args, 'fleet', False):
        from adopt import doctor_fleet
        sys.exit(doctor_fleet(include_secrets=getattr(args, 'secrets', False)))
    if getattr(args, 'project', None):
        from adopt import doctor_project
        sys.exit(doctor_project(args.project))
    issues = []
    reg_path = os.environ.get('CLANKER_REGISTRY', os.path.expanduser('~/projects/.clanker.yaml'))
    if os.path.exists(reg_path):
        try:
            import yaml
            with open(reg_path) as f:
                yaml.safe_load(f)
            print("✓ Registry valid")
        except Exception as e:
            print(f"✗ Registry invalid: {e}")
            issues.append("registry")
    else:
        print(f"✗ Registry missing: {reg_path}")
        issues.append("registry")

    data_dir = os.environ.get('CLANKER_DATA', '/data/clanker')
    for subdir in ['raw/sessions', 'raw/health', 'proposals', 'alerts', 'reports', 'audit', 'wiki']:
        path = os.path.join(data_dir, subdir)
        if os.path.isdir(path):
            print(f"✓ {subdir}/ exists")
        else:
            print(f"✗ {subdir}/ missing")
            issues.append(subdir)

    plugin_root = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..')
    hooks_json = os.path.join(plugin_root, 'hooks', 'hooks.json')
    if os.path.exists(hooks_json):
        print("✓ Plugin hooks.json exists")
    else:
        print("✗ Plugin hooks.json missing")
        issues.append("hooks")

    if os.path.exists(os.path.expanduser('~/bin/clanker')):
        print("✓ clanker in PATH")
    else:
        print("✗ clanker not in PATH")
        issues.append("path")

    # Check hooks in settings.json
    import json as _json
    try:
        with open(os.path.expanduser('~/.claude/settings.json')) as f:
            settings = _json.load(f)
        hook_events = settings.get('hooks', {})
        has_start = any('clanker' in h.get('command', '') for m in hook_events.get('SessionStart', []) for h in m.get('hooks', []))
        has_end = any('clanker' in h.get('command', '') for m in hook_events.get('SessionEnd', []) for h in m.get('hooks', []))
        print(f"{'✓' if has_start else '✗'} SessionStart hook registered")
        print(f"{'✓' if has_end else '✗'} SessionEnd hook registered")
        if not has_start: issues.append("session-start-hook")
        if not has_end: issues.append("session-end-hook")
    except:
        print("✗ Cannot read settings.json")
        issues.append("settings")

    # Repo ↔ installed hook parity (clanker sync --check, quiet)
    try:
        from synccmd import check as _sync_check
        drifted, missing, total = _sync_check(quiet=True)
        bad = len(drifted) + len(missing)
        print(f"{'✓' if bad == 0 else '✗'} Hook sync parity ({total - bad}/{total})"
              + ("" if bad == 0 else " — run: clanker sync"))
        if bad:
            issues.append("hook-sync")
    except Exception:
        print("✗ Hook sync check errored")

    # Check cron jobs
    import subprocess
    try:
        crons = subprocess.check_output(["crontab", "-l"], stderr=subprocess.DEVNULL, text=True)
        has_health = "clanker alert check" in crons
        has_weekly = "clanker analyze weekly" in crons
        print(f"{'✓' if has_health else '✗'} Health check cron installed")
        print(f"{'✓' if has_weekly else '✗'} Weekly analysis cron installed")
        if not has_health: issues.append("health-cron")
        if not has_weekly: issues.append("weekly-cron")
    except:
        print("✗ Cannot read crontab")

    if issues:
        print(f"\n{len(issues)} issue(s) found")
        sys.exit(1)
    else:
        print("\nAll checks passed")

