def cmd_new_watchdog(args):
    """Scaffold a new drift-watchdog plugin from the standard template.

    Class-of-bug pattern from eigenstateresearch Session 7: every config
    encoding an external fact needs a paired watchdog. This generator
    eliminates the 200-line boilerplate.
    """
    from plugins import scaffold_watchdog
    try:
        path = scaffold_watchdog(
            name=args.name, kind=args.kind, out_dir=args.dir,
        )
    except (ValueError, FileExistsError) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    print(f"Created watchdog scaffold at: {path}")
    print()
    print("Next steps:")
    print("  1. Edit load_local()  — point at your local config/map")
    print("  2. Edit fetch_remote() — wire up the external API call")
    print("  3. Edit compare()     — equality logic that returns drift list")
    print("  4. Symlink into /data/clanker/plugins/health-checks/ if needed")
    print(f"  5. Smoke test: {path}")

