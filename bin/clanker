def cmd_decompose(args):
    from decompose import check_prompt
    prompt = args.prompt or " ".join(args.text) if args.text else None
    if not prompt:
        import sys
        if not sys.stdin.isatty():
            prompt = sys.stdin.read().strip()
    if not prompt:
        print("Usage: clanker decompose 'your task description'")
        print("   or: echo 'task' | clanker decompose")
        return
    check_prompt(prompt, project=args.project)

