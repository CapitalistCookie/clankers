def cmd_compile(args):
    from wiki import compile_wiki
    articles = compile_wiki(dry_run=args.dry_run)
    if args.dry_run:
        print(f"Would write {articles} project articles (dry run)")
    else:
        print(f"Compiled {articles} project articles")
        from audit import log_change
        log_change("wiki-compiled", f"{articles} articles", {"dry_run": False})

def cmd_lint_wiki(args):
    from wiki import lint_wiki
    issues = lint_wiki()
    if issues:
        for i in issues:
            print(f"  ⚠ {i}")
        print(f"\n{len(issues)} issue(s) found")
    else:
        print("Wiki is clean — no issues found")

def cmd_init(args):
    from onboard import init_project, detect_archetype
    path = os.path.expanduser(f"~/projects/{args.name}")
    if args.detect:
        archetype, scores = detect_archetype(path)
        print(f"Detected: {archetype}")
        print(f"Scores: {scores}")
    else:
        init_project(args.name, archetype=args.archetype)
        from audit import log_change
        log_change("project-init", args.name, {"archetype": args.archetype})
        # Set up tmux session
        if not args.no_tmux:
            from tmux_manager import add_session
            add_session(args.name, path)

def cmd_remove(args):
    from onboard import remove_project
    from audit import log_change
    remove_project(args.name)
    log_change("project-removed", args.name)

def cmd_tmux(args):
    from tmux_manager import list_sessions, add_session, remove_session
    if args.action == 'list':
        print(list_sessions())
    elif args.action == 'add':
        add_session(args.name, args.path)
    elif args.action == 'remove':
        remove_session(args.name)

def cmd_new(args):
    from newsession import spawn
    name = " ".join(args.name) if args.name else None
    sess, msg = spawn(name=name, shell=args.shell)
    print(msg)
    return 0 if sess else 1

def cmd_open(args):
    from newsession import attach
    ok, msg = attach(args.name)
    print(msg)
    return 0 if ok else 1

def cmd_work(args):
    """`clanker work <project>` — launch (or reattach) a Claude work session IN the
    project's repo, so the repo's CLAUDE.md / skills / hooks / memory namespace load.
    Harness overhaul 2026-07-05: sessions belong in repos; ~ is for meta work only."""
    from registry import Registry
    from newsession import spawn, attach
    reg = Registry()
    name = args.project
    path = reg.get_path(name)
    if not path or not os.path.isdir(path):
        known = ", ".join(sorted(reg.projects.keys()))
        print(f"work: unknown project '{name}' (path: {path or '?'})\nregistered: {known}",
              file=sys.stderr)
        return 1
    if args.print_path:
        print(path)
        return 0
    sess, msg = spawn(name=name, cwd=path, shell=args.shell, resume=getattr(args, 'resume', None))
    print(msg)
    if not sess:
        return 1
    if not args.no_boot:
        # Crash-resilience (audit M1, 07-22 OOM): a work session absent from the
        # boot map dies with the box. Also covers the reattach path — sessions
        # created before this existed get registered on their next `work`.
        from tmux_manager import ensure_boot_entry
        ensure_boot_entry(sess, path)
    if args.no_attach:
        return 0
    ok, amsg = attach(sess)
    print(amsg)
    return 0 if ok else 1

def cmd_resurrect(args):
    """`clanker resurrect` — post-OOM/reboot fleet recovery: merge the registry
    into the boot map, then relaunch every mapped session that isn't running
    (via the boot script itself, so behavior can't drift from systemd's path)."""
    from tmux_manager import resurrect
    return resurrect(dry_run=args.dry_run, sync_registry=args.sync_registry)

def cmd_briefing(args):
    from briefing import generate_briefing
    from registry import Registry
    reg = Registry()
    if args.project not in reg.projects:
        # Global alerts used to make ANY name produce a truthy "briefing";
        # an unknown project is an error, not a briefing with no git section.
        print(f"No briefing data for {args.project} (not in registry)", file=sys.stderr)
        return 1
    briefing = generate_briefing(args.project, reg.get_path(args.project))
    if briefing:
        print(briefing)
    else:
        print(f"No briefing data for {args.project}", file=sys.stderr)
        return 1

