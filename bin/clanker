    if args.action == 'list':
        list_plugins()
    elif args.action == 'run-analyzers':
        run_all_analyzers()
    elif args.action == 'run-health':
        results = run_all_health_checks()
        for r in results:
            status = "OK" if r["exit_code"] == 0 else "FAIL"
            print(f"  [{status}] {r['name']}")

