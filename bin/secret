#!/usr/bin/env bash
# secret — minimal age-encrypted secret store (harness overhaul M2a, 2026-07-05).
#   secret set <name>   (value on stdin:  printf '%s' "$VAL" | secret set foo)
#   secret get <name>   (prints plaintext to stdout)
#   secret list
# Store: ~/.claude/secrets/<name>.age (encrypted — safe to commit; the ~/.claude
# repo tracks them). Private key: ~/.config/age/key.txt — CT 112 ONLY, chmod 600,
# NEVER committed/copied. Remote commands: expand locally, e.g.
#   PGPASSWORD="$(secret get eigenstate_db_password)" psql ...
set -euo pipefail

STORE="$HOME/.claude/secrets"
KEY="$HOME/.config/age/key.txt"

die() { echo "secret: $*" >&2; exit 1; }
[ -f "$KEY" ] || die "no age key at $KEY"

cmd="${1:-list}"
case "$cmd" in
  set)
    name="${2:?usage: secret set <name>  (value on stdin)}"
    recipient=$(grep -oE 'age1[a-z0-9]+' "$KEY" | head -1)
    [ -n "$recipient" ] || die "no public key found in $KEY"
    mkdir -p "$STORE"
    age -r "$recipient" -o "$STORE/$name.age"
    echo "stored: $name" >&2
    ;;
  get)
    name="${2:?usage: secret get <name>}"
    [ -f "$STORE/$name.age" ] || die "no such secret: $name (see: secret list)"
    age -d -i "$KEY" "$STORE/$name.age"
    ;;
  list)
    [ -d "$STORE" ] && ls -1 "$STORE" | sed 's/\.age$//' || true
    ;;
  *)
    die "unknown command: $cmd (set|get|list)"
    ;;
esac
