#!/usr/bin/env python3
"""Fake `tmux` for the session-account tests: sessions, panes and keys, with the
launch lines it is sent actually RUN (`bash -c <line>`), so the environment the
launch line builds is the environment the fake `claude` process gets.

State lives in $FAKE_TMUX_DIR/state.json; every call is logged to calls.log.
- A pane runs "claude" while the fake claude it launched is alive, else "bash".
- FAKE_TMUX_TRUST=1: a launch first shows Claude's workspace-trust dialog with the
  cursor on `No, exit` (Claude Code 2.1.263+). Down moves to Yes; Enter on Yes runs
  the launch; Enter on No drops it.
- `/exit` + Enter while claude runs: SIGTERM to that claude.
- FAKE_TMUX_MISSING_ONCE=1: the first launch fails like a launch during Claude Code's
  npm relink (`env: 'claude': No such file or directory`); later launches run.
- A target may be a pane id (%3). kill-session ends the processes the session ran.
"""
import fcntl
import json
import os
import signal
import subprocess
import sys
import time

D = os.environ["FAKE_TMUX_DIR"]
STATE = os.path.join(D, "state.json")
argv = sys.argv[1:]
with open(os.path.join(D, "calls.log"), "a") as f:
    f.write(" ".join(argv) + "\n")
lock = open(os.path.join(D, "lock"), "a")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    st = json.load(open(STATE))
except (OSError, ValueError):
    st = {"sessions": {}}


def save():
    with open(STATE + ".tmp", "w") as f:
        json.dump(st, f)
    os.replace(STATE + ".tmp", STATE)


def target():
    if "-t" not in argv:
        return None
    t = argv[argv.index("-t") + 1].split(":", 1)[0]
    if t.lstrip("=") in st.get("bridges", {}):
        return t.lstrip("=")
    if t.startswith("%"):
        return next((n for n, s in st["sessions"].items() if s["pane"] == t), None)
    t = t[1:] if t.startswith("=") else t
    return t if t in st["sessions"] else None


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        return open(f"/proc/{pid}/stat").read().split()[2] != "Z"
    except OSError:
        return False


def claude_pid(s):
    # the claude process is the child of the bash that ran the launch line
    b = s.get("bash_pid")
    if not alive(b):
        return None
    try:
        kids = [int(x) for x in open(f"/proc/{b}/task/{b}/children").read().split()]
    except OSError:
        kids = []
    for k in kids:
        if alive(k):
            return k
    try:   # bash may exec the last command itself: then bash_pid IS claude
        if not open(f"/proc/{b}/cmdline", "rb").read().startswith(b"bash"):
            return b
    except OSError:
        pass
    return None


def launch(name, s, line):
    if os.environ.get("FAKE_TMUX_MISSING_ONCE") == "1" and not st.get("missed"):
        st["missed"] = True        # the claude binary is being relinked (npm): the line fails at once
        s["err"] = "env: ‘claude’: No such file or directory"
        return
    s["err"] = ""
    env = dict(os.environ, FAKE_TMUX_PANE=s["pane"])
    p = subprocess.Popen(["bash", "-c", line], cwd=s["cwd"], env=env, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    s["bash_pid"] = p.pid


cmd = argv[0] if argv else ""
rc = 0
if cmd == "has-session":
    rc = 0 if target() else 1
elif cmd == "new-session" and "-t" in argv:
    # a grouped session (the dashboard's web-* terminal bridge): same windows, one group
    t = target()
    name = argv[argv.index("-s") + 1]
    if not t:
        rc = 1
    else:
        st["sessions"][t]["group"] = t
        st["bridges"] = dict(st.get("bridges", {}), **{name: t})
        save()
elif cmd == "new-session":
    name = argv[argv.index("-s") + 1]
    cwd = argv[argv.index("-c") + 1] if "-c" in argv else os.getcwd()
    st["panes_made"] = st.get("panes_made", 0) + 1          # pane ids are never reused
    st["sessions"][name] = {"cwd": cwd, "pane": "%" + str(st["panes_made"]), "bash_pid": None,
                            "trust": None, "pending": None, "typed": ""}
    save()
elif cmd == "display-message":
    t = target()
    if not t:
        rc = 1
    else:
        s = st["sessions"][t]
        c = "claude" if claude_pid(s) else "bash"
        fmt = argv[-1]
        out = (fmt.replace("#{pane_id}", s["pane"]).replace("#{pane_pid}", "1")
                  .replace("#{pane_current_command}", c).replace("#{pane_current_path}", s["cwd"]))
        print(out)
elif cmd == "capture-pane":
    t = target()
    if not t:
        rc = 1
    else:
        s = st["sessions"][t]
        if s.get("trust"):
            no, yes = ("❯ ", "  ") if s["trust"] == "no" else ("  ", "❯ ")
            print(f"Quick safety check: do you trust this folder?\n{no}No, exit\n{yes}Yes, I trust this folder")
        elif claude_pid(s):
            print("● ok\n" + "─" * 40 + "\n❯ " + s.get("typed", "") + "\n" + "─" * 40 + "\n  status line")
        else:
            print((s.get("err") + "\n" if s.get("err") else "") + "user@host:~$ ")
elif cmd == "send-keys":
    t = target()
    if not t:
        rc = 1
    else:
        s = st["sessions"][t]
        if "-l" in argv:
            text = argv[-1]
            if claude_pid(s):
                s["typed"] = s.get("typed", "") + text
            else:
                s["pending"] = text
        else:
            key = argv[-1]
            if s.get("trust"):
                if key == "Down":
                    s["trust"] = "yes"
                elif key == "Up":
                    s["trust"] = "no"
                elif key == "Enter":
                    if s["trust"] == "yes":
                        launch(t, s, s["pending"])
                    s["trust"], s["pending"] = None, None
            elif key == "C-c":
                s["typed"] = ""
            elif key == "Enter":
                cp = claude_pid(s)
                if cp and s.get("typed", "").strip() == "/exit":
                    os.kill(cp, signal.SIGTERM)
                    s["typed"] = ""
                elif not cp and s.get("pending"):
                    if os.environ.get("FAKE_TMUX_TRUST") == "1":
                        s["trust"] = "no"          # Claude starts and asks first
                    else:
                        launch(t, s, s["pending"])
                        s["pending"] = None
                else:
                    s["typed"] = ""
        save()
elif cmd == "kill-session":
    t = target()
    if not t:
        rc = 1
    else:
        if t in st.get("bridges", {}):
            st["bridges"].pop(t)
            save()
            lock.close()
            sys.exit(0)
        b = st["sessions"].pop(t).get("bash_pid")
        if alive(b):
            try:
                os.killpg(b, signal.SIGTERM)
            except OSError:
                pass
        save()
elif cmd == "list-sessions":
    for n, s in st["sessions"].items():
        print(argv[-1].replace("#{session_name}", n).replace("#{session_group}", s.get("group", ""))
              .replace("#{session_activity}", str(int(s.get("activity", time.time())))))
    for n, g in st.get("bridges", {}).items():
        print(argv[-1].replace("#{session_name}", n).replace("#{session_group}", g)
              .replace("#{session_activity}", str(int(time.time()))))
elif cmd == "ls":
    for n in st["sessions"]:
        print(f"{n}: 1 windows (created today)")
elif cmd == "list-panes":
    fmt = argv[-1]
    for n, s in st["sessions"].items():
        print(fmt.replace("#{pane_id}", s["pane"]).replace("#{session_name}", n).replace("#{pane_pid}", "0")
                 .replace("#{pane_current_command}", "claude" if claude_pid(s) else "bash")
                 .replace("#{session_attached}", "0").replace("#{pane_current_path}", s["cwd"]))
elif cmd in ("show-options",):
    rc = 1
print_rc = rc
lock.close()
sys.exit(print_rc)
